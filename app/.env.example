# Copia este archivo como .env (sin .example) y completa los valores.
# .env NUNCA se sube a ningun lado: esta excluido en .gitignore.
# La frase maestra NO va aqui: se configura dentro de la app (Ajustes -> Frase maestra).

# Credenciales de tu app en https://my.telegram.org (seccion "API development tools")
TG_API_ID=12345678
TG_API_HASH=tu_api_hash_aqui

# Canal privado donde se guardan los archivos cifrados (ID numerico, empieza con -100)
TG_CHANNEL_ID=-1001234567890
